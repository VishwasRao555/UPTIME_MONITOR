NODE_ENV=development
PORT=5000

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# REQUIRED in production — the server refuses to boot without it. In
# development one is generated at startup, so sessions end when you restart.
# Generate:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# JWT_SECRET=

# How long a session lasts. The cookie's Max-Age matches.
JWT_EXPIRES_DAYS=30

# The auth cookie is always httpOnly. The other two flags follow NODE_ENV and
# rarely need setting by hand:
#
#   COOKIE_SECURE     true when NODE_ENV=production, false on localhost (no TLS)
#   COOKIE_SAMESITE   'none' in production, 'lax' in development
#
# SameSite=none is what makes the split deployment work: the frontend is on
# Vercel and this API is on Railway — different sites — and browsers never
# attach a 'lax' cookie to a cross-site fetch. Getting this wrong looks like a
# login that succeeds and then immediately forgets you.
#
# Set them explicitly only if you host both halves on ONE origin, in which case
# COOKIE_SAMESITE=lax is the stricter and better choice.
# COOKIE_SECURE=true
# COOKIE_SAMESITE=none

# Leave false unless the app sits behind a proxy you control. Trusting
# X-Forwarded-For from anywhere lets a client forge its IP and walk past the
# login rate limiter.
#
# On Railway set this to true: requests arrive through Railway's edge proxy, so
# without it every client looks like the same proxy IP and the login rate
# limiter throttles all your users as though they were one attacker.
TRUST_PROXY=false

# ---------------------------------------------------------------------------
# Database — MongoDB Atlas
# ---------------------------------------------------------------------------
# Atlas UI → Connect → Drivers → Node.js. Two things the copied string needs
# before it will work:
#   1. Replace <password> with the *database user's* password (Atlas → Database
#      Access), percent-encoding @ : / ? # as %40 %3A %2F %3F %23 if present.
#   2. Keep a database name in the path (/uptime below). Without one Mongoose
#      connects happily and writes into a default "test" database instead.
#
# REQUIRED in production — the server refuses to boot without it rather than
# silently using the in-memory database and losing everything on each deploy.
# Leave it unset in development to boot a throwaway in-memory MongoDB.
# MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/uptime?retryWrites=true&w=majority

# Scheduler
# CHECK_TICK_SECONDS must be 1-59 — it becomes the seconds field of a cron
# expression, so a larger value would silently fall back to once a minute.
CHECK_TICK_SECONDS=30
FAILURE_THRESHOLD=3
REQUEST_TIMEOUT_MS=10000
RESULT_RETENTION_DAYS=30

# ---------------------------------------------------------------------------
# Alerts
# ---------------------------------------------------------------------------
# Comma-separated. Every listed channel receives every DOWN/RECOVERY alert,
# and one failing channel never blocks the others.
#   console  — writes to the log (no setup)
#   telegram — free, unlimited, pushes to your phone
#   email    — via Brevo (300/day free, forever)
NOTIFIER_CHANNELS=console

# How long to wait on a provider before giving up. Transient failures
# (timeout, 5xx, 429) are retried once; 4xx is not, since a bad token or an
# unverified sender cannot be fixed by trying again.
NOTIFY_TIMEOUT_MS=10000

# --- Telegram --------------------------------------------------------------
# 1. Message @BotFather in Telegram → /newbot → copy the token below
# 2. Open your new bot and send it any message (a bot cannot message you first)
# 3. npm run telegram:id   → prints the chat id to paste here
# TELEGRAM_BOT_TOKEN=123456789:AAE...
# TELEGRAM_CHAT_ID=987654321

# --- Email (Brevo) ---------------------------------------------------------
# Sign up at brevo.com → SMTP & API → Create an API key (v3).
# ALERT_EMAIL_FROM must be a *verified sender* in your Brevo account, or the
# API rejects the send with a 400.
# BREVO_API_KEY=xkeysib-...
# ALERT_EMAIL_FROM=alerts@yourdomain.com
# ALERT_EMAIL_FROM_NAME=Sentinel
# ALERT_EMAIL_TO=you@example.com,teammate@example.com

# Verify the whole setup without waiting for something to break:
#   npm run notify:test -- --both

# SSRF guard blocks private/loopback IPs. Set false only to monitor your LAN.
SSRF_GUARD=true

# Exact origins allowed to call this API with credentials, comma-separated.
# No trailing slashes, and the scheme matters. In production this must list your
# Vercel URL, e.g.
#   CORS_ORIGIN=https://uptime-monitor.vercel.app
# Vercel preview deployments get their own URLs and are not covered by the
# production entry — add one if you need a preview to talk to this API.
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info
