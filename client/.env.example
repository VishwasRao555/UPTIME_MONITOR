# Base URL for the API, including the /api suffix.
#
# Leave it unset in development: Vite's dev proxy (vite.config.js) forwards
# /api and /health to localhost:5000, so the relative default is same-origin
# and needs no configuration.
#
# In production it must be the full Railway URL, because the frontend is served
# from Vercel and a relative path would resolve against Vercel instead:
#
#   VITE_API_URL=https://<your-app>.up.railway.app/api
#
# Set it in the Vercel dashboard (Settings → Environment Variables). Vite
# inlines this value at BUILD time, so changing it requires a redeploy — an
# edit alone will not affect the already-built site.
#
# Whatever you set here, the API's CORS_ORIGIN on Railway must list this site's
# origin exactly, or the browser blocks every call.
VITE_API_URL=/api
